# Server
PORT=3001

# Database — PostgreSQL connection string
DATABASE_URL=postgresql://localhost:5432/soki_booking
# Optional: CA certificate (PEM contents) for full TLS verification of the DB connection
# DATABASE_CA_CERT=

# JWT — generate a long random string for production
JWT_SECRET=change_this_to_a_long_random_secret_in_production

# Admin credentials (used to seed the admin account on first run)
# ADMIN_PASSWORD is REQUIRED in production — pick a strong, unique password
ADMIN_EMAIL=admin@sokisocialsauna.nl
ADMIN_PASSWORD=kies_een_sterk_uniek_wachtwoord

# Stripe — test mode keys (get yours at https://dashboard.stripe.com/test/apikeys)
STRIPE_SECRET_KEY=sk_test_YOUR_KEY_HERE
STRIPE_PUBLISHABLE_KEY=pk_test_YOUR_KEY_HERE

# Email — sent via Brevo (see BREVO_API_KEY below)
EMAIL_FROM=hello@sokisocialsauna.nl
EMAIL_FROM_NAME=Soki Social Sauna

# Google OAuth
GOOGLE_CLIENT_ID=your_google_client_id.apps.googleusercontent.com

# Stripe webhook secret (get from Stripe Dashboard → Webhooks)
STRIPE_WEBHOOK_SECRET=whsec_YOUR_WEBHOOK_SECRET_HERE

# Public base URL (used for CORS and email links)
BASE_URL=https://yourdomain.com

# Sanity CMS — project ID and dataset name (public, non-secret)
SANITY_PROJECT_ID=your_sanity_project_id
SANITY_DATASET=production

# Brevo (email marketing) — for waitlist signups
BREVO_API_KEY=your_brevo_api_key
BREVO_LIST_ID=3
